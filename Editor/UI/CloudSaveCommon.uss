/* =========================================================================
 * UnityCloudSave - Modern Dark UI Toolkit Stylesheet
 * Compatible with Unity 2021.3+ UI Toolkit
 * Author: Cezar Wagenheimer
 * ========================================================================= */

.cs-root {
    flex-grow: 1;
    background-color: #13151B;
    color: #F1F5F9;
    padding: 12px 16px;
    font-size: 12px;
}

/* ---------------- HEADER BANNER ---------------- */
.cs-header {
    background-color: #1A1D26;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 8px;
    padding: 14px 18px;
    margin-bottom: 12px;
    border-left-width: 4px;
    border-left-color: #0EA5E9;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.cs-header-left {
    flex-direction: column;
}

.cs-title-row {
    flex-direction: row;
    align-items: center;
}

.cs-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.cs-author-badge {
    background-color: rgba(14, 165, 233, 0.15);
    border-color: rgba(14, 165, 233, 0.35);
    border-width: 1px;
    border-radius: 12px;
    padding: 2px 8px;
    margin-left: 10px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #7DD3FC;
}

.cs-subtitle {
    font-size: 11px;
    color: #94A3B8;
    margin-top: 3px;
}

.cs-header-right {
    flex-direction: row;
    align-items: center;
}

/* ---------------- METRICS BAR ---------------- */
.cs-metrics-row {
    flex-direction: row;
    margin-bottom: 12px;
}

.cs-metric-card {
    flex-grow: 1;
    background-color: #1A1D26;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 7px;
    padding: 10px 12px;
    margin-right: 8px;
    align-items: center;
}

.cs-metric-card:last-child {
    margin-right: 0;
}

.cs-metric-value {
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.cs-metric-label {
    font-size: 10px;
    color: #94A3B8;
    margin-top: 2px;
    -unity-text-align: middle-center;
}

.cs-progress-bar-bg {
    width: 100%;
    height: 4px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 2px;
    margin-top: 5px;
    overflow: hidden;
}

.cs-progress-bar-fill {
    height: 100%;
    background-color: #0EA5E9;
    border-radius: 2px;
}

/* ---------------- TAB BAR ---------------- */
.cs-tab-bar {
    flex-direction: row;
    background-color: #1A1D26;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 7px;
    padding: 3px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.cs-tab-btn {
    flex-grow: 1;
    height: 32px;
    border-radius: 5px;
    border-width: 0;
    background-color: transparent;
    color: #94A3B8;
    font-size: 11.5px;
    -unity-font-style: bold;
    padding: 4px 10px;
    margin: 0 2px;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.cs-tab-btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
}

.cs-tab-btn--active {
    background-color: #0284C7;
    color: #FFFFFF;
}

/* ---------------- CARDS ---------------- */
.cs-card {
    background-color: #1A1D26;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 10px;
}

.cs-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.cs-card-title {
    font-size: 13.5px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.cs-card-subtitle {
    font-size: 11px;
    color: #94A3B8;
    margin-top: 2px;
    white-space: normal;
}

.cs-card-body {
    flex-direction: column;
}

/* ---------------- STEP CARD (CHECKER) ---------------- */
.cs-step-card {
    background-color: #1E222D;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 7px;
    padding: 10px 12px;
    margin-bottom: 8px;
    border-left-width: 3px;
    border-left-color: #64748B;
}

.cs-step-card--pass {
    border-left-color: #10B981;
}

.cs-step-card--warn {
    border-left-color: #F59E0B;
}

.cs-step-card--fail {
    border-left-color: #EF4444;
}

.cs-step-card--blocked {
    border-left-color: #F97316;
}

.cs-step-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.cs-step-title-group {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.cs-step-title {
    font-size: 12.5px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.cs-step-obligation {
    font-size: 10px;
    color: #94A3B8;
    margin-left: 6px;
}

.cs-step-details {
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.05);
}

.cs-step-prop-row {
    flex-direction: row;
    margin-top: 3px;
    margin-bottom: 3px;
}

.cs-step-prop-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: #94A3B8;
    width: 140px;
}

.cs-step-prop-value {
    font-size: 11px;
    color: #E2E8F0;
    flex-grow: 1;
    white-space: normal;
}

/* ---------------- BUTTONS ---------------- */
.cs-btn {
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 11px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: #384256;
    background-color: #242938;
    color: #E2E8F0;
    cursor: link;
    transition-duration: 0.12s;
    transition-property: background-color, border-color;
}

.cs-btn:hover {
    background-color: #2E3547;
    color: #FFFFFF;
}

.cs-btn-primary {
    background-color: #0284C7;
    border-color: #0EA5E9;
    color: #FFFFFF;
}

.cs-btn-primary:hover {
    background-color: #0369A1;
    border-color: #38BDF8;
}

.cs-btn-secondary {
    background-color: #242938;
    border-color: #384256;
    color: #E2E8F0;
}

.cs-btn-secondary:hover {
    background-color: #2E3547;
    color: #FFFFFF;
}

.cs-btn-sm {
    padding: 3px 8px;
    font-size: 10px;
}

/* ---------------- BADGES ---------------- */
.cs-badge {
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 10px;
    -unity-font-style: bold;
    border-width: 1px;
}

.cs-badge-pass {
    background-color: rgba(16, 185, 129, 0.15);
    border-color: #10B981;
    color: #6EE7B7;
}

.cs-badge-warn {
    background-color: rgba(245, 158, 11, 0.18);
    border-color: #F59E0B;
    color: #FCD34D;
}

.cs-badge-fail {
    background-color: rgba(239, 68, 68, 0.18);
    border-color: #EF4444;
    color: #FCA5A5;
}

.cs-badge-info {
    background-color: rgba(14, 165, 233, 0.15);
    border-color: #0EA5E9;
    color: #7DD3FC;
}

.cs-badge-neutral {
    background-color: #242938;
    border-color: #384256;
    color: #94A3B8;
}

/* ---------------- CODE BOX ---------------- */
.cs-code-box {
    background-color: #12141A;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 11px;
    color: #6EE7B7;
    margin-top: 6px;
    margin-bottom: 6px;
    white-space: normal;
}
